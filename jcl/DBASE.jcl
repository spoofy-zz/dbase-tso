//DBASEBAT JOB (ACCT),'DBASE BAT',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//* Batch smoke run. Use the TSO CLIST SYS2.CMDPROC(DBASE) for interactive use.
//RUN      EXEC PGM=DBBATCH
//STEPLIB  DD DSN=IBMUSER.DBASE.LOAD,DISP=SHR
//DBASEV   DD DSN=IBMUSER.DBASE.KV,DISP=OLD
//IMPIN    DD *
3|PETRA|27|PULA|Y
/*
//EXPOUT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
CREATE PEOPLE ID N 8 NAME C 24 AGE N 3 CITY C 16 ACTIVE L 1
TABLES
APPEND ID=1 NAME=ANA AGE=42
APPEND ID=2 NAME=MARKO AGE=35 CITY=SPLIT ACTIVE=Y
APPEND FROM IMPIN
APPEND BLANK
REPLACE 2 NAME=IVAN
REPLACE CITY WITH ZAGREB FOR NAME=ANA
LOCATE FOR AGE>30
CONTINUE
SUM AGE
AVERAGE AGE
INDEX ON ID TO PID
INDEXES
SET INDEX TO PID
SEEK 2
CREATE ORDERS CUSTID N 8 ITEM C 16
APPEND CUSTID=2 ITEM=BOOK
APPEND CUSTID=1 ITEM=PEN
USE PEOPLE
SET RELATION TO ID INTO ORDERS ON CUSTID
GO 2
LIST
DISPLAY
LIST FOR CITY=SPLIT
GO TOP
SKIP 1
DELETE 1
DELETE FOR AGE<30
RECALL ALL
COPY TO EXPOUT
COUNT
QUIT
/*
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
