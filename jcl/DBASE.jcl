//DBASEBAT JOB (ACCT),'DBASE BAT',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//* Batch smoke run. Use the TSO CLIST SYS2.CMDPROC(DBASE) for interactive use.
//RUN      EXEC PGM=DBBATCH
//STEPLIB  DD DSN=RVEZ001.DBASE.LOAD,DISP=SHR
//DBASED   DD DSN=RVEZ001.DBASE.TEXT,DISP=OLD
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
CREATE PEOPLE ID 8 NAME 24 AGE 3
APPEND ID=1 NAME=ANA AGE=42
APPEND ID=2 NAME=MARKO AGE=35
LIST
COUNT
QUIT
/*
